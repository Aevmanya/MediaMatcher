# Copy this file to secrets.toml for local development, then fill in real values.
# Do NOT commit secrets.toml to GitHub.
TMDB_API_KEY = "replace_with_your_rotated_tmdb_api_key"

[mysql]
host = "your-hosted-mysql-hostname"
port = 3306
user = "your-database-user"
password = "replace_with_a_new_database_password"
database = "movie_recommender"
# If your provider gives you a CA certificate, add its local path, for example:
# ssl_ca = "ca.pem"
